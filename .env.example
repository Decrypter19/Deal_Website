# Port the server listens on (hosts like Render/Railway set this automatically)
PORT=3000
# Where the SQLite database file lives (use a persistent disk in production)
DB_PATH=./data/deal.sqlite
# Comma-separated emails that always get the officer role when they sign up.
# (The very first account created is also made an officer automatically.)
OFFICER_EMAILS=
# Comma-separated fragments an email must contain/end with to count as a school address
SCHOOL_DOMAINS=brophybroncos.org,xaviersaints.org,.edu,k12.
